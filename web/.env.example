# GIWA Sepolia RPC URL (기본값: https://sepolia-rpc.giwa.io/)
VITE_RPC_URL=
# 배포 후 등록된 각 EAS 스키마 UID를 입력합니다.
VITE_NOTE_SCHEMA_UID=
VITE_DECISION_SCHEMA_UID=
VITE_SETTLEMENT_SCHEMA_UID=
VITE_CHALLENGE_SCHEMA_UID=
# 배포된 각 resolver 주소를 입력합니다.
VITE_NOTE_RESOLVER=
VITE_DECISION_RESOLVER=
VITE_SETTLEMENT_RESOLVER=
VITE_CHALLENGE_RESOLVER=
# Dojang 검증 스키마 UID. 비어 있으면 검증 스냅샷 UID는 0으로 기록됩니다.
VITE_DOJANG_SCHEMA_UID=
